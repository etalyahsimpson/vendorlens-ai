# VendorLens AI - environment configuration placeholders.
# Copy to .env (backend) or export before running services. No real secrets required.

# --- Database ---
# Docker Compose default (PostgreSQL). Local quick start uses SQLite by default.
DATABASE_URL=postgresql+psycopg://vendorlens:vendorlens@localhost:5432/vendorlens

# --- Application ---
# Where the bundled sample CSV lives (relative to repository root).
VENDORLENS_SAMPLE_CSV=./data/sample_suppliers.csv
# Trained model bundle used by the API (relative to repository root).
VENDORLENS_MODEL_PATH=./artifacts/model_bundle.joblib
# Model evaluation report consumed by GET /api/v1/model/metrics.
VENDORLENS_METRICS_PATH=./reports/metrics.json
# Comma-separated allowlist for browser origins.
VENDORLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://localhost:8080

# --- ML experiment tracking ---
# Local filesystem tracking (no external server required).
MLFLOW_TRACKING_URI=./mlruns
